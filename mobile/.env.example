# Valores públicos de ejemplo. Nunca colocar secretos en EXPO_PUBLIC_.
# Para celular físico usar la IP LAN o el túnel HTTPS del backend.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Opcional: si está vacía, Socket.IO usa EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_WS_URL=http://10.0.2.2:3000

# Aplicación Native de Auth0; mismo dominio/audience que el backend.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Navegador: Client ID de una aplicación Auth0 Single Page Application separada.
EXPO_PUBLIC_AUTH0_WEB_CLIENT_ID=
# npm run web usa estas URL, independientes del emulador Android.
EXPO_PUBLIC_WEB_API_URL=http://localhost:3000
# Opcional; vacía usa EXPO_PUBLIC_WEB_API_URL.
EXPO_PUBLIC_WEB_WS_URL=
