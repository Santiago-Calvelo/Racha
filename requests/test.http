# REST Client de VS Code. Tokens de dos cuentas en el entorno del proceso.
# No guardar tokens reales en este archivo. Ver README raíz, Parte III.
# Los pedidos de alias son solo para el primer ingreso. Conserva datos creados.
@baseUrl = http://localhost:3000
@ana = {{$processEnv TEST_AUTH0_TOKEN_ANA}}
@bruno = {{$processEnv TEST_AUTH0_TOKEN_BRUNO}}
@hoy = {{$datetime "YYYY-MM-DD" -3 h}}
@fin = {{$datetime "YYYY-MM-DD" 6 d}}

### 1. Primera identidad — 200, crea/reconoce por Auth0
# @name creadora
GET {{baseUrl}}/me
Authorization: Bearer {{ana}}

### 2. Alias de la primera identidad — 200 (409 si ya eligió uno)
PATCH {{baseUrl}}/me/alias
Authorization: Bearer {{ana}}
Content-Type: application/json

{ "alias": "ana_{{$timestamp}}" }

### 3. Segunda identidad — 200
# @name participante
GET {{baseUrl}}/me
Authorization: Bearer {{bruno}}

### 4. Alias de la segunda identidad — 200 (409 si ya eligió uno)
PATCH {{baseUrl}}/me/alias
Authorization: Bearer {{bruno}}
Content-Type: application/json

{ "alias": "bruno_{{$timestamp}}" }

### 5. Crear desafío — 201; el creador sale del token
# @name desafio
POST {{baseUrl}}/desafios
Authorization: Bearer {{ana}}
Content-Type: application/json

{
  "nombre": "Caminar cada día HTTP",
  "categoria": "SALUD",
  "fechaInicio": "{{hoy}}",
  "fechaFin": "{{fin}}",
  "maximoParticipantes": 10
}

### 6. Unirse por código — 201
POST {{baseUrl}}/participaciones
Authorization: Bearer {{bruno}}
Content-Type: application/json

{ "codigoInvitacion": "{{desafio.response.body.$.codigoInvitacion}}" }

### 7. Registrar check-in — 201
POST {{baseUrl}}/checkin
Authorization: Bearer {{bruno}}
Content-Type: application/json

{ "desafio": "{{desafio.response.body.$.id}}", "dia": "hoy", "nota": "Caminé treinta minutos", "valor": 30 }

### 8. Duplicado — 409
POST {{baseUrl}}/checkin
Authorization: Bearer {{bruno}}
Content-Type: application/json

{ "desafio": "{{desafio.response.body.$.id}}" }

### 9. Ranking — 200
GET {{baseUrl}}/desafios/{{desafio.response.body.$.id}}/ranking
Authorization: Bearer {{ana}}

### 10. Resumen de inicio — 200
GET {{baseUrl}}/personas/{{participante.response.body.$.id}}/inicio
Authorization: Bearer {{bruno}}

### 11. Historial paginado — 200
GET {{baseUrl}}/checkin/desafio/{{desafio.response.body.$.id}}/persona/{{participante.response.body.$.id}}?pagina=1&limite=5
Authorization: Bearer {{bruno}}

### 12. Deshacer — 200
DELETE {{baseUrl}}/checkin/ultimo
Authorization: Bearer {{bruno}}
Content-Type: application/json

{ "desafio": "{{desafio.response.body.$.id}}" }

### 13. Historial luego de deshacer — 200, items vacío
GET {{baseUrl}}/checkin/desafio/{{desafio.response.body.$.id}}/persona/{{participante.response.body.$.id}}
Authorization: Bearer {{bruno}}

### 14. Filtros y página — 200
GET {{baseUrl}}/desafios?categoria=SALUD&estado=ACTIVO&pagina=1&limite=5
Authorization: Bearer {{ana}}

### 15. Página inválida — 400
GET {{baseUrl}}/desafios?pagina=0
Authorization: Bearer {{ana}}

### 16. Cancelación ajena — 403
POST {{baseUrl}}/desafios/{{desafio.response.body.$.id}}/cancelar
Authorization: Bearer {{bruno}}

### 17. Actor en body rechazado — 400
POST {{baseUrl}}/checkin
Authorization: Bearer {{bruno}}
Content-Type: application/json

{ "desafio": "{{desafio.response.body.$.id}}", "persona": "{{creadora.response.body.$.id}}" }

### 18. Sin token — 401
GET {{baseUrl}}/me

### 19. Token inválido — 401
GET {{baseUrl}}/me
Authorization: Bearer token-invalido-de-prueba

### 20. Perfil propio — 200
PATCH {{baseUrl}}/me
Authorization: Bearer {{ana}}
Content-Type: application/json

{ "nombre": "Ana HTTP", "zonaHoraria": "America/Argentina/Buenos_Aires" }

### 21. Abandonar — 201, conserva participación histórica
POST {{baseUrl}}/desafios/{{desafio.response.body.$.id}}/abandonar
Authorization: Bearer {{bruno}}

### 22. Cancelar como creador — 201
POST {{baseUrl}}/desafios/{{desafio.response.body.$.id}}/cancelar
Authorization: Bearer {{ana}}
