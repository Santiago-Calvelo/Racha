{
  "name": "racha",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "^24.15.0 || >=26.0.0" },
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix mobile",
    "start": "npm --prefix backend run start",
    "mobile": "npm --prefix mobile run start --",
    "android": "npm --prefix mobile run android --",
    "web": "npm --prefix mobile run web --",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix backend run build",
    "test": "npm --prefix backend test -- --runInBand",
    "test:e2e": "npm --prefix backend run test:e2e -- --runInBand",
    "test:mobile": "npm --prefix mobile test",
    "typecheck": "npm --prefix mobile run typecheck",
    "lint": "node backend/node_modules/oxlint/bin/oxlint backend/src backend/test mobile/src mobile/test mobile/scripts"
  }
}
