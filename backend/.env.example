# Completar localmente. Nunca commitear backend/.env ni credenciales reales.
PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/rachas

# Auth0: dominio sin https:// ni barra final; API con firma RS256.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# No se necesita Client Secret: el backend verifica claves públicas JWKS.
# Google Client ID/Secret se configuran en Auth0, no en la app móvil.

# Parte IV: nombres reservados; todavía no implementados ni validados.
MIN_APP_VERSION=1.0.0
RECOMMENDED_APP_VERSION=1.1.0
V1_SUNSET_DATE=

# Opcionales para el recorrido REST Client; access tokens de dos cuentas.
# Son secretos: solo en el entorno local del proceso, nunca en la colección.
TEST_AUTH0_TOKEN_ANA=
TEST_AUTH0_TOKEN_BRUNO=
