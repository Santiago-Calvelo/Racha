{
  "info": {"_postman_id": "bc672d83-19fa-4254-9b0f-d1342be68a80", "name": "Rachas · Partes I–III", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Ejecutar las carpetas en orden con dos cuentas Auth0 distintas. Definir tokenAna y tokenBruno como variables locales de un entorno privado (access tokens para la API, nunca ID tokens). No exportar secretos. Captura IDs/código automáticamente, crea un desafío, lo activa y comprueba estados. Conserva personas/participaciones y desafío cancelado al finalizar. Puede modificar el nombre/zona de Ana. Cada ejecución crea un desafío adicional; si se interrumpe, revisar el límite de 5 vigentes antes de repetir. No valida Socket.IO ni hace login social: ver catálogo y pruebas en README."},
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAna}}", "type": "string"}]},
  "variable": [{"key": "baseUrl", "value": "http://localhost:3000", "type": "string"}, {"key": "personaAnaId", "value": "", "type": "string"}, {"key": "personaBrunoId", "value": "", "type": "string"}, {"key": "desafioId", "value": "", "type": "string"}, {"key": "codigoInvitacion", "value": "", "type": "string"}, {"key": "hoy", "value": "", "type": "string"}, {"key": "finActivo", "value": "", "type": "string"}, {"key": "manana", "value": "", "type": "string"}, {"key": "finProgramado", "value": "", "type": "string"}],
  "item": [
