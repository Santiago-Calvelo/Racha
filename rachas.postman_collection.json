        {
          "name": "08 · Crear desafío programado",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/desafios",
            "description": "Crea un desafío nuevo y conserva ID/código. No elimina datos previos. El siguiente pedido lo adelanta a hoy para probar check-ins.",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{tokenAna}}", "type": "string"}]},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nombre\": \"Caminar HTTP\",\n  \"categoria\": \"SALUD\",\n  \"fechaInicio\": \"{{manana}}\",\n  \"fechaFin\": \"{{finProgramado}}\",\n  \"maximoParticipantes\": 10\n}", "options": {"raw": {"language": "json"}}}
          },
          "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Argentina/Buenos_Aires', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());", "const mover = n => { const d = new Date(hoy + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };", "pm.collectionVariables.set('hoy', hoy); pm.collectionVariables.set('finActivo', mover(6)); pm.collectionVariables.set('manana', mover(1)); pm.collectionVariables.set('finProgramado', mover(7));"]}}, {"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) { const d = pm.response.json(); pm.collectionVariables.set('desafioId', d.id); pm.collectionVariables.set('codigoInvitacion', d.codigoInvitacion); }"]}}]
        },
