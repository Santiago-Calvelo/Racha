            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"fechaInicio\": \"{{hoy}}\",\n  \"fechaFin\": \"{{finActivo}}\"\n}", "options": {"raw": {"language": "json"}}}
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"]}}]
