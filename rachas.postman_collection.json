          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Alias elegido o ya definido', function () {", "  if (pm.response.code === 200) pm.expect(pm.response.json().alias).to.be.a('string');", "  else { pm.response.to.have.status(409); pm.expect(pm.response.json().message).to.eql('El alias ya fue elegido'); }", "});"]}}]
